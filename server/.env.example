# Optional official offer providers.
# If credentials are absent, Specly skips that provider without failing comparison.

# Yandex Market Referral API
# Docs: https://yandex.ru/dev/market/affiliate/ru/
# Paste the raw Referral API authorization key (for example, y0__...) here.
# Specly automatically sends it as: Authorization: OAuth <key>
YANDEX_MARKET_AUTH_KEY=
# Legacy alias kept for backward compatibility:
YANDEX_MARKET_AFFILIATE_TOKEN=
# Set one numeric identifier. PLACE_ID is preferred when available.
YANDEX_MARKET_PLACE_ID=
YANDEX_MARKET_CLID=

# AliExpress Affiliate API / TOP
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# Optional affiliate parameters
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_APP_SIGNATURE=
ALIEXPRESS_TARGET_CURRENCY=RUB
ALIEXPRESS_TARGET_LANGUAGE=RU
ALIEXPRESS_SHIP_TO_COUNTRY=RU

# Existing optional reader fallback
JINA_API_KEY=

# Fetch/browser diagnostics and tuning
DIRECT_FETCH_USER_AGENT=
NAV_TIMEOUT_MS=25000
READY_TIMEOUT_MS=7000
# Disabled by default: loading the full public page is more reliable for anti-bot-sensitive stores.
BLOCK_HEAVY_RESOURCES=false
PORT=8080
